    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-18230",
    "@opentui/core": "0.5.3",
    "@opentui/solid": "0.5.3",
    "@opentui/keymap": "^0.5.3",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.14",
    "typescript": "^5.8.2"
  }
